# Salin ke .env di root workspace lalu isi sesuai provider yang dipakai.
#
# Provider Gemini (default):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
#
# Provider OpenAI-compatible (gateway lokal, mis. http://localhost:20128/v1):
# CHAT_PROVIDER=openai-compat
# CHAT_BASE_URL=http://localhost:20128/v1
# CHAT_MODEL=ocg/muse-spark-1.3-contributor
# CHAT_FALLBACK_MODELS=
# CHAT_API_KEY=x
# CHAT_TIMEOUT_S=120
# CHAT_REASONING_EFFORT=minimal
EMBED_MODEL=gemini-embedding-2
VECTOR_COLLECTION=rag_web_gemini-embedding-2_v2
# Default storage sudah benar relatif terhadap paket: backend/rag/storage dan
# backend/rag/storage/chroma. Set hanya bila ingin lokasi lain (path relatif
# diresolusikan dari cwd, jadi jalankan dari D:\chunking\backend).
# CHROMA_PATH=rag/storage/chroma
# RAG_STORAGE=rag/storage
# Sumber handoff pipeline. Path relatif diresolusikan dari cwd; CLI --source
# lebih disarankan, mis. dari backend:
#   py -m rag.ingest_from_staging --source ..\data\handoff\current\ready_for_vector_db_v2.json --reindex
# STAGING_SOURCE=data/handoff/current/ready_for_vector_db_v2.json
RAG_TOP_K=5
RAG_MAX_TOP_K=10
VECTOR_MIN_SCORE=0.64
RAG_MAX_CHUNK_CHARS=1500
EMBED_BATCH=50
EMBED_RPM=90
EMBED_429_RETRIES=6
RAG_MAX_ROUNDTRIPS=5
RAG_HISTORY_TURNS=10
# Frontend yang di-host terpisah (Vite dev/preview sudah ditangani proxy).
# RAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
