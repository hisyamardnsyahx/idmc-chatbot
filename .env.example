# Copy this file to .env and fill in real values. NEVER commit the real
# .env file — it's already in .gitignore.

# Backend RAG (detail: backend/rag/.env.example)
EMBED_MODEL=gemini-embedding-2
VECTOR_COLLECTION=rag_web_gemini-embedding-2_v2
# STAGING_SOURCE=data/handoff/current/ready_for_vector_db_v2.json

# Gemini credentials for embeddings and chat.
# GEMINI_API_KEY="paste-gemini-api-key-here"

# Fallback session cookies used if the portal doesn't set them automatically.
# Get these by logging into https://idmc.jogjaprov.go.id/, opening
# DevTools > Application > Cookies, and copying the current values.
DWH_COOKIE_APP_SESSION="paste-app-session-cookie-value-here"
DWH_COOKIE_LARAVEL_SESSION="paste-laravel-session-cookie-value-here"
DWH_COOKIE_XSRF_EXTRA="paste-extra-xsrf-cookie-value-here"
DWH_COOKIE_XSRF_TOKEN="paste-xsrf-token-value-here"
