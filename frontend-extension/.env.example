# Full chat endpoint, not a base URL. Leave blank to ship the "service unavailable" placeholder.
# Development may use loopback HTTP; production must be HTTPS.
WXT_CHAT_API_URL=
# WXT_CHAT_API_URL=http://127.0.0.1:8001/api/chat
# Production example: https://rag.example.org/api/chat
# WXT_ variables are public build configuration. Never put provider API keys here.
